class Solution:
    def subsets(self, nums: List[int]) -> List[List[int]]:
        res = []
        subset = []

        def backtrack(i):
            # Base case: if we've considered all elements
            if i >= len(nums):
                res.append(subset.copy())
                return
            
            # Decision to include nums[i]
            subset.append(nums[i])
            backtrack(i + 1)
            
            # Decision NOT to include nums[i]
            subset.pop()
            backtrack(i + 1)

        backtrack(0)
        return res
