import math

class Solution:
    def getPermutation(self, n: int, k: int) -> str:
        # Create a list of digits to pick from
        digits = [str(i) for i in range(1, n + 1)]
        
        # Precompute factorials up to (n-1)
        factorials = [1] * n
        for i in range(1, n):
            factorials[i] = factorials[i-1] * i
            
        # Convert k to 0-indexed
        k -= 1
        
        res = []
        # Build the permutation digit by digit
        for i in range(n - 1, -1, -1):
            # idx determines which digit to pick from the current list
            idx = k // factorials[i]
            k %= factorials[i]
            
            res.append(digits[idx])
            # Remove used digit to maintain relative order
            digits.pop(idx)
            
        return "".join(res)
