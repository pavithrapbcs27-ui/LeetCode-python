class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        # Dictionary to store the Next Greater Element for each number in nums2
        # Key: number, Value: its next greater element
        nge_map = {}
        stack = []
        
        # Build the map using a Monotonic Stack
        for num in nums2:
            # While stack isn't empty and current num is greater than stack top
            while stack and num > stack[-1]:
                smaller_num = stack.pop()
                nge_map[smaller_num] = num
            
            stack.append(num)
        
        # Elements remaining in stack have no next greater element
        # (Though dict.get() can handle the default -1 for us later)
        
        # Build the result for nums1 using our map
        return [nge_map.get(n, -1) for n in nums1]
