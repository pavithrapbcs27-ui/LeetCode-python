class Solution:
    def climbStairs(self, n: int) -> int:
        # Base cases
        if n <= 2:
            return n
        
        # a represents ways to reach (n-2)
        # b represents ways to reach (n-1)
        a, b = 1, 2
        
        for i in range(3, n + 1):
            # The current step is the sum of the previous two
            current = a + b
            # Update variables for the next iteration
            a = b
            b = current
            
        return b
